{
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:integration": "node --env-file=.env --conditions=react-server --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "check:gemini": "node --env-file=.env --conditions=react-server --import tsx scripts/check-gemini-plan.ts",
    "check:connections": "node --env-file=.env --import tsx scripts/check-connections.ts",
    "format:check": "prettier --check app components lib scripts tests *.json *.ts *.mjs compose.yaml",
    "lint": "eslint .",
    "check:paypal": "node --env-file=.env --conditions=react-server --import tsx scripts/check-paypal-checkout.ts",
    "verify:paypal": "node --env-file=.env --conditions=react-server --import tsx scripts/verify-paypal-capture.ts",
    "check:deadlines": "node --env-file=.env --conditions=react-server --import tsx scripts/check-delivery-deadlines.ts",
    "check:deploy": "node --env-file-if-exists=.env --import tsx scripts/check-deploy.ts",
    "build:deploy": "npm run check:deploy && npm run db:generate && npm run build"
  },
  "dependencies": {
    "@bryntum/calendar": "npm:@bryntum/calendar-trial@7.3.7",
    "@bryntum/calendar-react": "7.3.7",
    "@prisma/client": "^6.19.3",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "^16.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-syntax-typescript": "^7.29.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "name": "dealmile",
  "version": "0.1.0",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
